# AeroGuard-RAG Environment Variables Template
# Copy this file to .env and insert your personal API keys

# Gemini API Key (Google AI Studio)
Gemini_APIKEY=your_gemini_api_key_here

# Groq API Key (Free tier Llama-3.3-70B)
GROQ_APIKEY=your_groq_api_key_here

# Optional Model Configuration Defaults
GROQ_MODEL_NAME=llama-3.3-70b-versatile
GEMINI_MODEL_NAME=gemini-2.5-flash

